<Window x:Class="ScreenTimeGuardian.LockScreen.LockMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTime Guardian"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FF1A1A2E"
        Closing="Window_Closing">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1A1A2E" Offset="0"/>
                <GradientStop Color="#FF16213E" Offset="0.5"/>
                <GradientStop Color="#FF0F3460" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,60,0,0" HorizontalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       Text="Time for a break!"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="#FF00D2FF"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Step away from the screen and rest your eyes"
                       FontSize="20"
                       Foreground="#AAFFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="#22FFFFFF"
                    CornerRadius="20"
                    Padding="60,40"
                    HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="BREAK ENDS IN"
                               FontSize="16"
                               Foreground="#AAFFFFFF"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="CountdownText"
                               Text="15:00"
                               FontSize="96"
                               FontWeight="Bold"
                               Foreground="#FF00D2FF"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,60">
            <Button x:Name="ParentUnlockButton"
                    Content="Parent Unlock"
                    FontSize="16"
                    Padding="30,12"
                    Background="#4400D2FF"
                    Foreground="White"
                    BorderBrush="#FF00D2FF"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    Cursor="Hand"
                    Click="ParentUnlockButton_Click"/>

            <Grid x:Name="PinPanel"
                  Visibility="Collapsed"
                  Margin="0,20,0,0">
                <Border Background="#33FFFFFF"
                        CornerRadius="12"
                        Padding="30,20"
                        MinWidth="300">
                    <StackPanel>
                        <TextBlock Text="Enter Parent PIN"
                                   FontSize="18"
                                   Foreground="#FF00D2FF"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <PasswordBox x:Name="PinInput"
                                     FontSize="24"
                                     MaxLength="6"
                                     Padding="10"
                                     HorizontalContentAlignment="Center"
                                     PasswordChanged="PinInput_PasswordChanged"/>

                        <TextBlock x:Name="PinErrorText"
                                   Text=""
                                   FontSize="14"
                                   Foreground="#FFFF4444"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,15,0,0">
                            <Button Content="Unlock"
                                    FontSize="14"
                                    Padding="20,8"
                                    Margin="0,0,10,0"
                                    Background="#FF00D2FF"
                                    Foreground="#FF1A1A2E"
                                    FontWeight="Bold"
                                    Click="PinUnlock_Click"/>

                            <Button Content="Cancel"
                                    FontSize="14"
                                    Padding="20,8"
                                    Background="#44FFFFFF"
                                    Foreground="White"
                                    Click="PinCancel_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
